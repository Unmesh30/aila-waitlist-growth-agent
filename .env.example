# Aila Waitlist Agent Configuration

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Reddit Search Configuration
REDDIT_USER_AGENT=AilaWaitlistAgent/1.0 (travel app lead finder)
REDDIT_SEARCH_LIMIT=50

# Scoring Thresholds - Dynamic Top-N Selection
MIN_LEAD_SCORE=5           # Soft threshold - leads above this are preferred
MIN_LEADS_TO_KEEP=20       # Always keep at least this many (even if scores are low)
MAX_LEADS_TO_KEEP=50       # Maximum leads to keep

# Database
DATABASE_PATH=data/waitlist_leads.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
